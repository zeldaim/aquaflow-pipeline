# 복사해서 .env 로 (.env 는 git 에 올라가지 않음)

# data.go.kr 「한국수자원공사_실시간 수도정보 수질(시간) 조회 서비스」(15057290) 활용 신청 후 받은 인증키 (Decoding 키)
KWATER_API_KEY=
# 작업별 경로가 명세에 안 보여 확인 필요 — 마이페이지의 요청 주소로 바꾼다
# KWATER_QUALITY_URL=https://apis.data.go.kr/B500001/rwis/waterQuality/list

# S3 호환 저장소. docker compose 로 돌리면 S3_ENDPOINT 는 compose 가 LocalStack(http://s3:4566)으로 넣는다.
# LocalStack 은 키를 검사하지 않아 test 로 둔다. 실제 AWS 로 바꿀 때는 S3_ENDPOINT 를 비우고 IAM 키(최소 권한)를 쓴다.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET=kwater

# 자동 수집 알림 (선택) — Slack 호환 웹훅 ({"text": ...}). 비우면 화면에만 출력
ALERT_WEBHOOK_URL=

# 자동 수집: 한 번에 받을 최근 시간 (기본 compose 12 · 직접 실행 6). 절전이 길면 늘림
# AQUAFLOW_HOURS=12
